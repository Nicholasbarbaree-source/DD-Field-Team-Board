<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DD Field Board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --ink:#1B2430;
    --ink-soft:#5B6472;
    --paper:#EEF0F2;
    --panel:#FFFFFF;
    --navy:#0F2B00;
    --navy-2:#173D00;
    --green:#288F00;
    --green-bright:#5FCC2E;
    --green-bg:#E3F1DB;
    --amber:#E86500;
    --amber-bg:#FBE1CC;
    --rust:#B00020;
    --rust-bg:#F4D4DA;
    --magenta:#AA0053;
    --magenta-bg:#F3D9E6;
    --teal:#288F00;
    --teal-bg:#E3F1DB;
    --line:#D3D7DC;
    --line-strong:#B7BCC3;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Space Grotesk',sans-serif;
    font-size:14px;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;}
  button{font-family:inherit;cursor:pointer;}
  .app{max-width:1200px;margin:0 auto;padding:0 20px 64px;}

  /* HERO */
  .hero{
    background:var(--navy);
    color:#fff;
    margin:0 -20px;
    padding:36px 20px 28px;
    position:relative;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute; inset:0;
    background:repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 1px, transparent 1px 64px);
    pointer-events:none;
  }
  .hero-top{display:flex;justify-space-between;align-items:flex-start;gap:24px;flex-wrap:wrap;position:relative;z-index:1;}
  .hero-title{font-size:28px;font-weight:600;letter-spacing:-0.01em;margin:0;color:var(--green-bright);}
  .hero-sub{color:#A8B5A0;margin:6px 0 0;font-size:13px;}
  .hero-asof{text-align:right;font-size:12px;color:#A8B5A0;}
  .hero-asof .val{color:#fff;font-weight:600;}
  .kpi-row{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:1px;
    margin-top:28px;
    background:rgba(255,255,255,0.12);
    border-radius:2px;
    overflow:hidden;
    position:relative;
    z-index:1;
  }
  .kpi{background:var(--navy-2);padding:16px 14px;min-width:0;}
  .kpi .num{
    font-family:'IBM Plex Mono',monospace;
    font-size:30px;
    font-weight:600;
    line-height:1;
    display:flex;align-items:baseline;gap:6px;
  }
  .kpi .num .flag{font-size:12px;font-weight:500;padding:2px 6px;border-radius:3px;}
  .kpi .lbl{font-size:11.5px;color:#A8B5A0;margin-top:8px;letter-spacing:.01em;}
  .kpi.warn .num{color:#FF6FB0;}
  .kpi.crit .num{color:#FF5C72;}
  .kpi.good .num{color:var(--green-bright);}

  /* RM STRIP */
  .section-label{
    font-size:12px;
    color:var(--ink-soft);
    text-transform:none;
    margin:40px 0 12px;
    display:flex;align-items:center;gap:10px;
  }
  .section-label .line{flex:1;height:1px;background:var(--line);}
  .rm-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;}
  .rm-card{
    background:var(--panel);
    border:1px solid var(--line);
    border-left:4px solid var(--line-strong);
    padding:14px 14px 12px;
  }
  .rm-card[data-health="good"]{border-left-color:var(--teal);}
  .rm-card[data-health="watch"]{border-left-color:var(--magenta);}
  .rm-card[data-health="help"]{border-left-color:var(--rust);}
  .rm-name{font-weight:600;font-size:13.5px;}
  .rm-role{font-size:11px;color:var(--ink-soft);margin-bottom:10px;}
  .rm-metric-row{display:flex;justify-content:space-between;font-size:12px;padding:3px 0;border-top:1px solid #F0F1F3;}
  .rm-metric-row .v{font-family:'IBM Plex Mono',monospace;font-weight:600;}
  .rm-metric-row .v.amber{color:var(--magenta);}
  .rm-metric-row .v.rust{color:var(--rust);}
  .rm-bar-track{height:5px;background:#EEEFF1;border-radius:3px;margin-top:9px;overflow:hidden;}
  .rm-bar-fill{height:100%;background:var(--green);}

  /* CHARTS */
  .chart-row{display:grid;grid-template-columns:1.3fr 1fr;gap:16px;}
  .chart-row-single{grid-template-columns:1fr;margin-top:16px;}
  .chart-panel{background:var(--panel);border:1px solid var(--line);padding:16px 16px 8px;}
  .chart-panel h3{font-size:13.5px;margin:0 0 2px;font-weight:600;}
  .chart-panel .desc{font-size:11.5px;color:var(--ink-soft);margin:0 0 10px;}
  .chart-wrap{position:relative;height:220px;}
  .chart-toggle{display:flex;gap:6px;margin-bottom:8px;}
  .toggle-btn{
    background:#F7F8F9;border:1px solid var(--line);color:var(--ink-soft);
    font-size:11px;font-weight:500;padding:5px 10px;border-radius:2px;
  }
  .toggle-btn.active{background:var(--navy);color:#fff;border-color:var(--navy);font-weight:600;}
  .workload-row{
    display:grid;grid-template-columns:repeat(5,1fr);gap:8px;
    margin-top:10px;padding-top:10px;border-top:1px solid var(--line);
  }
  .workload-cell{font-size:10.5px;color:var(--ink-soft);}
  .workload-cell .rm{font-weight:600;color:var(--ink);font-size:10.5px;display:block;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .workload-cell .stat{display:flex;justify-content:space-between;}
  .workload-cell .stat .v{font-family:'IBM Plex Mono',monospace;}

  /* TABS / TABLES */
  .tabs{display:flex;gap:2px;margin-top:8px;}
  .tab-btn{
    background:transparent;
    border:1px solid var(--line);
    border-bottom:none;
    padding:9px 16px;
    font-size:12.5px;
    font-weight:500;
    color:var(--ink-soft);
    border-radius:2px 2px 0 0;
  }
  .tab-btn.active{background:var(--panel);color:var(--ink);border-color:var(--line-strong);font-weight:600;}
  .tab-panel{display:none;background:var(--panel);border:1px solid var(--line);}
  .tab-panel.active{display:block;}
  .table-toolbar{
    display:flex;gap:10px;align-items:center;flex-wrap:wrap;
    padding:12px 14px;border-bottom:1px solid var(--line);
  }
  .table-toolbar input[type=text]{
    font-family:inherit;font-size:12.5px;padding:6px 10px;
    border:1px solid var(--line);border-radius:2px;flex:1;min-width:160px;
  }
  .table-toolbar select{
    font-family:inherit;font-size:12.5px;padding:6px 8px;
    border:1px solid var(--line);border-radius:2px;
  }
  .table-count{font-size:11.5px;color:var(--ink-soft);margin-left:auto;}
  table{width:100%;border-collapse:collapse;font-size:12.5px;}
  thead th{
    text-align:left;padding:8px 12px;
    background:#F7F8F9;color:var(--ink-soft);
    font-weight:600;font-size:11px;
    border-bottom:1px solid var(--line);
    cursor:pointer;user-select:none;
    white-space:nowrap;
  }
  thead th:hover{color:var(--ink);}
  tbody td{padding:7px 12px;border-bottom:1px solid #F0F1F3;vertical-align:middle;}
  tbody tr:hover{background:#FAFBFC;}
  .scroll-body{max-height:420px;overflow-y:auto;}
  .badge{
    display:inline-block;padding:2px 7px;border-radius:3px;
    font-size:10.5px;font-weight:600;font-family:'IBM Plex Mono',monospace;
    white-space:nowrap;
  }
  .badge.b-rust{background:var(--rust-bg);color:#7A0016;}
  .badge.b-magenta{background:var(--magenta-bg);color:#7A0038;}
  .badge.b-amber{background:var(--amber-bg);color:#9E4700;}
  .badge.b-teal{background:var(--teal-bg);color:#1D6600;}
  .badge.b-grey{background:#ECEDEF;color:#5B6472;}

  /* UPDATE SECTION */
  .update-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .update-panel{background:var(--panel);border:1px solid var(--line);padding:16px;}
  .update-panel h4{font-size:13px;margin:0 0 4px;}
  .update-panel p.desc{font-size:11.5px;color:var(--ink-soft);margin:0 0 12px;}
  .dropzone{
    border:1.5px dashed var(--line-strong);
    border-radius:3px;
    padding:22px 14px;
    text-align:center;
    font-size:12px;
    color:var(--ink-soft);
    cursor:pointer;
  }
  .dropzone:hover{border-color:var(--navy-2);color:var(--navy-2);}
  .manual-form{display:grid;gap:8px;}
  .manual-row{display:grid;grid-template-columns:130px repeat(5,1fr);gap:6px;align-items:center;font-size:11.5px;}
  .manual-row input{
    font-family:inherit;font-size:12px;padding:5px 6px;border:1px solid var(--line);border-radius:2px;width:100%;
  }
  .manual-row.head{font-weight:600;color:var(--ink-soft);font-size:10.5px;}
  .btn-primary{
    background:var(--navy);color:#fff;border:none;padding:9px 16px;
    font-size:12.5px;font-weight:600;border-radius:2px;margin-top:10px;
  }
  .btn-primary:hover{background:var(--navy-2);}
  .log-list{margin-top:14px;font-size:11.5px;color:var(--ink-soft);}
  .log-list .entry{padding:6px 0;border-top:1px solid #F0F1F3;display:flex;justify-content:space-between;}
  .toast{
    position:fixed;bottom:20px;right:20px;background:var(--navy);color:#fff;
    padding:10px 16px;font-size:12.5px;border-radius:3px;box-shadow:0 4px 16px rgba(0,0,0,0.2);
    opacity:0;transform:translateY(8px);transition:all .25s;pointer-events:none;z-index:50;
  }
  .toast.show{opacity:1;transform:translateY(0);}

  /* FOOTER / DEFINITIONS */
  .defs{margin-top:40px;border-top:1px solid var(--line);padding-top:16px;}
  .defs summary{cursor:pointer;font-size:12.5px;font-weight:600;color:var(--ink-soft);}
  .defs dl{font-size:12px;color:var(--ink-soft);margin:12px 0 0;display:grid;grid-template-columns:200px 1fr;gap:6px 14px;}
  .defs dt{font-weight:600;color:var(--ink);}

  @media (max-width:900px){
    .kpi-row{grid-template-columns:repeat(3,1fr);}
    .rm-strip{grid-template-columns:repeat(2,1fr);}
    .chart-row{grid-template-columns:1fr;}
    .update-grid{grid-template-columns:1fr;}
    .manual-row{grid-template-columns:90px repeat(5,1fr);font-size:10px;}
  }

  /* PAGE SWITCHER */
  .page-switcher{background:var(--navy);display:flex;gap:2px;padding:10px 20px 0;}
  .page-switcher-inner{max-width:1200px;margin:0 auto;display:flex;gap:2px;width:100%;}
  .page-tab{
    background:transparent;border:none;color:#A8B5A0;
    font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:500;
    padding:10px 18px;border-radius:3px 3px 0 0;cursor:pointer;
  }
  .page-tab.active{background:var(--paper);color:var(--ink);font-weight:600;}
  .page-tab:hover:not(.active){color:#fff;}
  .page{display:none;}
  .page.active{display:block;}

  /* FINANCIALS PAGE */
  .fin-wrap{max-width:1200px;margin:0 auto;padding:28px 20px 64px;}
  .fin-funnel{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;margin-bottom:8px;border:1px solid var(--line);}
  .fin-fstage{background:var(--panel);padding:16px 14px;position:relative;}
  .fin-fstage + .fin-fstage{border-left:1px solid var(--line);}
  .fin-fstage .n{font-family:'IBM Plex Mono',monospace;font-size:26px;font-weight:600;line-height:1;}
  .fin-fstage .lbl{font-size:12px;color:var(--ink-soft);margin-top:6px;}
  .fin-fstage .sub{font-size:10.5px;color:var(--ink-soft);margin-top:2px;font-family:'IBM Plex Mono',monospace;}
  .fin-fstage.new .n{color:var(--ink-soft);}
  .fin-fstage.submitted .n{color:var(--amber);}
  .fin-fstage.needsinfo .n{color:var(--rust);}
  .fin-fstage.approved .n{color:var(--green);}
  .fin-funnel-note{font-size:12px;color:var(--ink-soft);margin-bottom:36px;}
  .fin-funnel-note b{color:var(--ink);}
  .fin-rm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;margin-bottom:36px;}
  .fin-rm-card{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--line-strong);padding:14px;}
  .fin-rm-card[data-health="good"]{border-left-color:var(--teal);}
  .fin-rm-card[data-health="watch"]{border-left-color:var(--magenta);}
  .fin-rm-card[data-health="help"]{border-left-color:var(--rust);}
  .fin-rm-head{font-weight:600;font-size:13.5px;margin-bottom:10px;}
  .fin-rm-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px 10px;}
  .fin-rm-stats .v{font-family:'IBM Plex Mono',monospace;font-size:16px;font-weight:600;}
  .fin-rm-stats .v.flag{color:var(--rust);}
  .fin-rm-stats .v.ok{color:var(--green);}
  .fin-rm-stats .k{font-size:10.5px;color:var(--ink-soft);margin-top:1px;}
  .fin-rm-foot{margin-top:12px;padding-top:10px;border-top:1px solid #F0F1F3;font-size:11px;color:var(--ink-soft);display:flex;justify-content:space-between;}
  .fin-status-pill{display:inline-block;padding:2px 7px;border-radius:3px;font-size:10.5px;font-weight:600;font-family:'IBM Plex Mono',monospace;white-space:nowrap;}
  .fin-status-pill.needsinfo{background:var(--rust-bg);color:#7A0016;}
  .fin-status-pill.submitted{background:var(--amber-bg);color:#9E4700;}
  .fin-status-pill.new{background:#ECEDEF;color:var(--ink-soft);}
  .fin-age.hot{color:var(--rust);font-weight:600;}
  .fin-age.warm{color:var(--amber);font-weight:600;}
  .fin-notes{max-width:280px;color:var(--ink-soft);font-size:11.5px;line-height:1.4;}
  .fin-ph-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:20px;}
  .fin-ph{border:1px dashed var(--line-strong);border-radius:2px;padding:16px;color:var(--ink-soft);}
  .fin-ph .fin-ph-title{font-size:13px;color:var(--ink);font-weight:600;margin-bottom:4px;}
  .fin-ph .fin-ph-sub{font-size:11.5px;}

  /* ESCALATIONS PAGE */
  .esc-alert{
    display:flex;gap:14px;align-items:flex-start;
    background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--rust);
    padding:16px 18px;margin-top:24px;
  }
  .esc-alert .big{
    font-family:'IBM Plex Mono',monospace;font-size:38px;font-weight:600;line-height:1;
    color:var(--rust);font-variant-numeric:tabular-nums;flex:none;
  }
  .esc-alert .body{font-size:13px;line-height:1.5;}
  .esc-alert .body b{font-weight:600;}
  .esc-alert .sub{font-size:11.5px;color:var(--ink-soft);margin-top:5px;}
  .esc-rm-list{display:grid;gap:12px;}
  .esc-rm{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--line-strong);padding:15px 18px;}
  .esc-rm[data-health="good"]{border-left-color:var(--teal);}
  .esc-rm[data-health="watch"]{border-left-color:var(--magenta);}
  .esc-rm[data-health="help"]{border-left-color:var(--rust);}
  .esc-rm-top{display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap;}
  .esc-rm-name{font-size:15px;font-weight:600;}
  .esc-rm-name .tag{font-size:10.5px;font-weight:500;color:var(--ink-soft);margin-left:7px;}
  .esc-rm-name .tag.no-action{
    background:var(--rust-bg);color:#7A0016;font-weight:600;
    padding:2px 7px;border-radius:3px;font-family:'IBM Plex Mono',monospace;
  }
  .esc-verdict{display:inline-block;padding:3px 9px;border-radius:3px;font-size:10.5px;font-weight:600;font-family:'IBM Plex Mono',monospace;white-space:nowrap;}
  .esc-verdict.good{background:var(--teal-bg);color:#1D6600;}
  .esc-verdict.watch{background:var(--magenta-bg);color:#7A0038;}
  .esc-verdict.help{background:var(--rust-bg);color:#7A0016;}
  .esc-split{display:grid;grid-template-columns:minmax(150px,auto) 1fr;gap:18px;margin-top:12px;padding-top:12px;border-top:1px solid #F0F1F3;align-items:start;}
  .esc-count{text-align:left;}
  .esc-count .n{font-family:'IBM Plex Mono',monospace;font-size:40px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums;}
  .esc-count .n.flag{color:var(--rust);}
  .esc-count .n.warn{color:var(--magenta);}
  .esc-count .n.ok{color:var(--green);}
  .esc-count .lbl{font-size:10.5px;color:var(--ink-soft);margin-top:5px;line-height:1.3;}
  .esc-bars{display:grid;gap:5px;margin-top:11px;}
  .esc-bar{display:grid;grid-template-columns:82px 1fr 26px;gap:7px;align-items:center;font-size:10.5px;color:var(--ink-soft);}
  .esc-bar .track{height:7px;background:#EEEFF1;border-radius:4px;overflow:hidden;}
  .esc-bar .fill{height:100%;}
  .esc-bar .fill.ds{background:var(--amber);}
  .esc-bar .fill.ir{background:var(--green);}
  .esc-bar .fill.ni{background:var(--rust);}
  .esc-bar .v{font-family:'IBM Plex Mono',monospace;font-weight:600;color:var(--ink);text-align:right;}
  .esc-notes{margin:0;padding-left:16px;font-size:12.5px;line-height:1.55;}
  .esc-notes li{margin-bottom:4px;}
  .esc-meta{display:flex;gap:16px;flex-wrap:wrap;margin-top:11px;padding-top:10px;border-top:1px solid #F0F1F3;font-size:11px;color:var(--ink-soft);}
  .esc-meta .v{font-family:'IBM Plex Mono',monospace;font-weight:600;color:var(--ink);}
  .esc-footnote{
    margin-top:28px;padding:14px 16px;background:#F7F8F9;border:1px solid var(--line);
    font-size:12px;color:var(--ink-soft);line-height:1.55;
  }
  .esc-footnote b{color:var(--ink);}

  @media (max-width:900px){
    .esc-split{grid-template-columns:1fr;}
    .esc-alert{flex-direction:column;gap:8px;}
  }

  /* CASE ESCALATIONS PAGE */
  .csc-flags{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-bottom:36px;}
  .csc-flag{background:var(--panel);border:1px solid var(--line);border-top:3px solid var(--line-strong);padding:15px 16px 13px;display:flex;flex-direction:column;}
  .csc-flag[data-sev="high"]{border-top-color:var(--rust);}
  .csc-flag[data-sev="mid"]{border-top-color:var(--magenta);}
  .csc-flag .n{font-family:'IBM Plex Mono',monospace;font-size:32px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums;}
  .csc-flag[data-sev="high"] .n{color:var(--rust);}
  .csc-flag[data-sev="mid"] .n{color:var(--magenta);}
  .csc-flag[data-zero="1"] .n{color:var(--green);}
  .csc-flag .t{font-size:12.5px;font-weight:600;margin-top:7px;}
  .csc-flag .d{font-size:11px;color:var(--ink-soft);margin-top:5px;line-height:1.45;flex:1;}
  .csc-flag .who{margin-top:10px;padding-top:9px;border-top:1px solid #F0F1F3;font-size:10.5px;color:var(--ink-soft);display:flex;flex-wrap:wrap;gap:4px 10px;}
  .csc-flag .who .v{font-family:'IBM Plex Mono',monospace;font-weight:600;color:var(--ink);}

  .csc-snap{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px;margin-bottom:36px;}
  .csc-panel{background:var(--panel);border:1px solid var(--line);padding:15px 16px;}
  .csc-panel h4{margin:0 0 3px;font-size:12.5px;font-weight:600;}
  .csc-panel .sub{font-size:10.5px;color:var(--ink-soft);margin:0 0 11px;line-height:1.4;}
  .csc-rows{display:grid;gap:6px;}
  .csc-row{display:grid;grid-template-columns:104px 1fr 30px;gap:8px;align-items:center;font-size:11px;color:var(--ink-soft);}
  .csc-row .track{height:8px;background:#EEEFF1;border-radius:4px;overflow:hidden;}
  .csc-row .fill{height:100%;background:var(--green);}
  .csc-row .fill.warn{background:var(--amber);}
  .csc-row .fill.bad{background:var(--rust);}
  .csc-row .fill.neutral{background:var(--navy-2);}
  .csc-row .v{font-family:'IBM Plex Mono',monospace;font-weight:600;color:var(--ink);text-align:right;}

  .csc-flagpill{
    display:inline-block;padding:2px 6px;border-radius:3px;margin:1px 2px 1px 0;
    font-size:10px;font-weight:600;font-family:'IBM Plex Mono',monospace;white-space:nowrap;
    background:var(--magenta-bg);color:#7A0038;
  }
  .csc-flagpill.high{background:var(--rust-bg);color:#7A0016;}
  .csc-clean{font-size:10.5px;color:var(--green);font-weight:600;}
  .csc-nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(96px,1fr));gap:10px;margin:13px 0 4px;padding:12px 0;border-top:1px solid #F0F1F3;border-bottom:1px solid #F0F1F3;}
  .csc-nums .v{font-family:'IBM Plex Mono',monospace;font-size:17px;font-weight:600;font-variant-numeric:tabular-nums;}
  .csc-nums .v.flag{color:var(--rust);}
  .csc-nums .v.warn{color:var(--magenta);}
  .csc-nums .v.ok{color:var(--green);}
  .csc-nums .k{font-size:10.5px;color:var(--ink-soft);margin-top:2px;line-height:1.3;}

  @media (max-width:900px){
    .csc-flags{grid-template-columns:1fr;}
    .csc-snap{grid-template-columns:1fr;}
  }
</style>
</head>
<body>

<div class="page-switcher">
  <div class="page-switcher-inner" id="pageSwitcher">
    <button class="page-tab active" data-page="caseboard">Case Board</button>
    <button class="page-tab" data-page="financials">Field Team Financials</button>
    <button class="page-tab" data-page="escalations">Daily Log Escalations</button>
    <button class="page-tab" data-page="caseesc">Case Escalations</button>
  </div>
</div>

<div id="page-caseboard" class="page active">
  <div class="app">

    <div class="hero">
      <div class="hero-top">
        <div>
          <h1 class="hero-title">DD Case Board</h1>
          <p class="hero-sub">Fill-In &amp; Performance case tracking metrics for the Dedicated Driver Field Team</p>
        </div>
        <div class="hero-asof">
          <div>Snapshot as of</div>
          <div class="val" id="asOfLabel">—</div>
        </div>
      </div>
      <div class="kpi-row" id="kpiRow"></div>
    </div>

    <div class="section-label"><span>By RM</span><span class="line"></span></div>
    <div class="rm-strip" id="rmStrip"></div>

    <div class="section-label"><span>Trends</span><span class="line"></span></div>
    <div class="chart-row">
      <div class="chart-panel">
        <h3>Fill-in actioning timeliness, by RM</h3>
        <p class="desc">Share of fill-in requests where the RM's first action happened by deadline. Built from status-history log.</p>
        <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
      </div>
      <div class="chart-panel">
        <h3>Performance cases: <span id="perfChartTitle">opened per week</span></h3>
        <p class="desc" id="perfChartDesc">Case volume by RM, last 12 weeks — from full performance-case history.</p>
        <div class="chart-toggle" id="perfToggle">
          <button class="toggle-btn active" data-mode="volume">Opened per week</button>
          <button class="toggle-btn" data-mode="close">Avg days to action/close</button>
        </div>
        <div class="chart-wrap"><canvas id="volumeChart"></canvas></div>
        <div id="perfWorkload" class="workload-row"></div>
      </div>
    </div>

    <div class="chart-row chart-row-single">
      <div class="chart-panel">
        <h3>Cases RMs created themselves, by day</h3>
        <p class="desc">Of cases where the RM personally logged it (not the intake form or ops team member).</p>
        <div class="chart-wrap"><canvas id="creatorChart"></canvas></div>
      </div>
    </div>

    <div class="section-label"><span>Case detail</span><span class="line"></span></div>
    <div class="tabs" id="tabBar">
      <button class="tab-btn active" data-tab="fillin">Open Fill-In Cases</button>
      <button class="tab-btn" data-tab="chronic">Last-Minute Requesters</button>
      <button class="tab-btn" data-tab="perf">Open Performance Cases</button>
    </div>

    <div class="tab-panel active" id="panel-fillin">
      <div class="table-toolbar">
        <input type="text" id="fillinSearch" placeholder="Search driver or subject…">
        <select id="fillinRmFilter"><option value="">All RMs</option></select>
        <select id="fillinActionFilter">
          <option value="">All statuses</option>
          <option value="ACTION NEEDED">Action Needed</option>
          <option value="OVERDUE">Overdue</option>
          <option value="In Progress">In Progress</option>
          <option value="On Track">On Track</option>
        </select>
        <span class="table-count" id="fillinCount"></span>
      </div>
      <div class="scroll-body">
        <table>
          <thead><tr>
            <th data-key="owner">RM</th>
            <th data-key="driver">Driver</th>
            <th data-key="status">Case Status</th>
            <th data-key="opened">Opened</th>
            <th data-key="needed">1st Fill-In Needed</th>
            <th data-key="noticeDays">Notice (days)</th>
            <th data-key="action">Action Status</th>
            <th>Salesforce</th>
          </tr></thead>
          <tbody id="fillinBody"></tbody>
        </table>
      </div>
    </div>

    <div class="tab-panel" id="panel-chronic">
      <div class="table-toolbar">
        <input type="text" id="chronicSearch" placeholder="Search driver…">
        <select id="chronicFlagFilter">
          <option value="">All drivers</option>
          <option value="Chronic">Chronic only (3+ short-notice)</option>
          <option value="Occasional">Occasional (1-2)</option>
        </select>
        <span class="table-count" id="chronicCount"></span>
      </div>
      <div class="scroll-body">
        <table>
          <thead><tr>
            <th data-key="name">Driver</th>
            <th data-key="total">Total Requests (all-time)</th>
            <th data-key="critical">Critical (≤48h)</th>
            <th data-key="lastMinute">Last-Minute (&lt;7d)</th>
            <th data-key="short">Short-Notice Total</th>
            <th data-key="pct">% Short-Notice</th>
            <th data-key="mostRecent">Most Recent</th>
            <th data-key="flag">Flag</th>
          </tr></thead>
          <tbody id="chronicBody"></tbody>
        </table>
      </div>
    </div>

    <div class="tab-panel" id="panel-perf">
      <div class="table-toolbar">
        <input type="text" id="perfSearch" placeholder="Search subject or geo…">
        <select id="perfRmFilter"><option value="">All RMs</option></select>
        <select id="perfFlagFilter">
          <option value="">All statuses</option>
          <option value="OVERDUE">Overdue</option>
          <option value="In Review">In Review</option>
          <option value="Open">Open</option>
        </select>
        <span class="table-count" id="perfCount"></span>
      </div>
      <div class="scroll-body">
        <table>
          <thead><tr>
            <th data-key="owner">RM</th>
            <th data-key="subject">Subject</th>
            <th data-key="status">Status</th>
            <th data-key="opened">Opened</th>
            <th data-key="daysOpen">Days Open</th>
            <th data-key="geo">Geo</th>
            <th data-key="flag">Follow-Up Flag</th>
            <th>Salesforce</th>
          </tr></thead>
          <tbody id="perfBody"></tbody>
        </table>
      </div>
    </div>

    <div class="section-label"><span>Log this week's snapshot</span><span class="line"></span></div>
    <div class="update-grid">
      <div class="update-panel">
        <h4>Upload new Salesforce exports</h4>
        <p class="desc">Drop the report exports here to process locally in browser.</p>
        <div class="dropzone" id="dropzone">Click to choose files, or drag them here<br><span style="font-size:10.5px;">.xlsx exports, any of the reports</span></div>
        <input type="file" id="fileInput" multiple accept=".xlsx" style="display:none;">
        <div id="uploadStatus" style="font-size:11.5px;color:var(--ink-soft);margin-top:8px;"></div>
      </div>
      <div class="update-panel">
        <h4>...or log quick numbers by hand</h4>
        <p class="desc">Enter current open counts per RM to update historical trends manually.</p>
        <div class="manual-form" id="manualForm"></div>
        <button class="btn-primary" id="saveManualBtn">Save snapshot</button>
      </div>
    </div>
    <div class="log-list" id="logList"></div>

    <details class="defs">
      <summary>Definitions &amp; details</summary>
      <dl>
        <dt>Notice Given</dt><dd>1st Date Fill-In Needed minus the date the case was opened.</dd>
        <dt>Critical</dt><dd>48 hours (2 days) or less notice.</dd>
        <dt>Last-Minute</dt><dd>Less than 7 days notice (but more than 48 hours).</dd>
      </dl>
    </details>

  </div>
</div>

<div id="page-financials" class="page">
  <div class="fin-wrap">
    <div class="hero" style="margin:0 -20px 0;">
      <div class="hero-top">
        <div>
          <h1 class="hero-title">DD Field Team Financials</h1>
          <p class="hero-sub">Daily log funnel, working speed, and dollars in motion</p>
        </div>
        <div class="hero-asof">
          <div>Snapshot as of</div>
          <div class="val" id="finAsOfLabel">—</div>
        </div>
      </div>
    </div>

    <div class="section-label" style="margin-top:28px;"><span>This Pay Period Funnel</span><span class="line"></span></div>
    <div class="fin-funnel">
      <div class="fin-fstage new"><div class="n" id="finPeriodNew">–</div><div class="lbl">New / No Time</div></div>
      <div class="fin-fstage submitted"><div class="n" id="finPeriodSubmitted">–</div><div class="lbl">Submitted / Review</div></div>
      <div class="fin-fstage needsinfo"><div class="n" id="finPeriodNeedsInfo">–</div><div class="lbl">Needs Info</div></div>
      <div class="fin-fstage approved"><div class="n" id="finPeriodApproved">–</div><div class="lbl">Approved</div></div>
    </div>
    <div class="fin-funnel-note">Current period pipeline: <b id="finPeriodOpenDollars">–</b> across <b id="finPeriodOpenCount">–</b> logs.</div>

    <div class="section-label"><span>Backlog Funnel</span><span class="line"></span></div>
    <div class="fin-funnel">
      <div class="fin-fstage new"><div class="n" id="finBacklogNew">–</div><div class="lbl">New / No Time</div></div>
      <div class="fin-fstage submitted"><div class="n" id="finBacklogSubmitted">–</div><div class="lbl">Submitted / Review</div></div>
      <div class="fin-fstage needsinfo"><div class="n" id="finBacklogNeedsInfo">–</div><div class="lbl">Needs Info</div></div>
      <div class="fin-fstage approved"><div class="n" id="finBacklogOldest">–</div><div class="lbl">Oldest (days)</div></div>
    </div>
    <div class="fin-funnel-note">Backlog pipeline: <b id="finBacklogOpenDollars">–</b> across <b id="finBacklogOpenCount">–</b> logs.</div>

    <div class="section-label"><span>RM Working Speed &amp; Volume</span><span class="line"></span></div>
    <div class="fin-rm-grid" id="finRmGrid"></div>

    <div class="section-label"><span>Open Daily Logs Needing Action</span><span class="line"></span></div>
    <div class="tab-panel active" style="display:block;">
      <div class="table-toolbar">
        <input type="text" id="finSearch" placeholder="Search driver or RM…">
        <select id="finStatusFilter">
          <option value="">All statuses</option>
          <option value="New">New</option>
          <option value="Driver Submitted">Driver Submitted</option>
          <option value="Initial Review Completed">In Review</option>
          <option value="Additional Information Required">Needs Info</option>
        </select>
        <span class="table-count" id="finCount"></span>
      </div>
      <div class="scroll-body">
        <table>
          <thead><tr>
            <th>RM</th><th>Status</th><th>Age</th><th>Date</th><th>Driver</th><th>Log</th><th>Amount</th><th>Notes</th><th>Salesforce</th>
          </tr></thead>
          <tbody id="finBody"></tbody>
        </table>
      </div>
    </div>

    <div class="section-label"><span>Open Expenses</span><span class="line"></span></div>
    <div class="tab-panel active" style="display:block;">
      <div class="table-toolbar">
        <input type="text" id="finExpSearch" placeholder="Search driver…">
        <select id="finExpTypeFilter"><option value="">All types</option></select>
        <span class="table-count" id="finExpCount"></span>
      </div>
      <div class="scroll-body">
        <table>
          <thead><tr>
            <th>RM</th><th>Driver</th><th>Type</th><th>Amount</th><th>Status</th><th>Notes</th><th>Salesforce</th>
          </tr></thead>
          <tbody id="finExpBody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div id="page-escalations" class="page">
  <div class="fin-wrap">
    <div class="hero" style="margin:0 -20px 0;">
      <div class="hero-top">
        <div>
          <h1 class="hero-title">Daily Log Escalations</h1>
          <p class="hero-sub">Pay period daily logs sitting open by Regional Manager</p>
        </div>
      </div>
    </div>
    <div class="esc-alert" id="escAlert"></div>
    <div class="section-label"><span>Waiting on each RM</span><span class="line"></span></div>
    <div class="esc-rm-list" id="escRmList"></div>
  </div>
</div>

<div id="page-caseesc" class="page">
  <div class="fin-wrap">
    <div class="hero" style="margin:0 -20px 0;">
      <div class="hero-top">
        <div>
          <h1 class="hero-title">Case Escalations</h1>
          <p class="hero-sub">Risk tracking for open fill-in and performance cases</p>
        </div>
      </div>
    </div>
    <div class="section-label"><span>Red Flags</span><span class="line"></span></div>
    <div class="csc-flags" id="cscFlagPools"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// Base Seed Data Container
const SEED = {
  "asOf": "2026-09-23", 
  "asOfStamp": "9/23/2026 7:39 AM PT", 
  "rms": ["Adam Moszczynski", "Cesar Perez", "Chris Messimer", "Kevin Thompson", "Raul Torres"],
  "totals": {"openFillIn": 57, "openPerformance": 19, "actionNeeded": 10, "overdue": 15, "chronicDrivers": 76, "totalDrivers": 292},
  "fillinOpen": [],
  "fillinOpenByRm": {"Adam Moszczynski":{"open":0,"actionNeeded":0,"overdue":0},"Cesar Perez":{"open":10,"actionNeeded":6,"overdue":0},"Chris Messimer":{"open":15,"actionNeeded":2,"overdue":0},"Kevin Thompson":{"open":23,"actionNeeded":2,"overdue":0},"Raul Torres":{"open":9,"actionNeeded":0,"overdue":1}},
  "chronicDrivers": [],
  "perfOpen": [],
  "perfOpenByRm": {"Adam Moszczynski":{"open":2,"overdue":2},"Cesar Perez":{"open":1,"overdue":1},"Chris Messimer":{"open":0,"overdue":0},"Kevin Thompson":{"open":14,"overdue":11},"Raul Torres":{"open":2,"overdue":0}},
  "perfTrend": {"monthly":{}, "weekly":{"weeks":[], "series":{}}},
  "timeliness": {"tiers":["Urgent (≤14 days notice)", "Standard advance (>14 days notice)", "Long assignment (>14 days notice, >2wk duration)"], "rms":["Adam Moszczynski", "Cesar Perez", "Chris Messimer", "Kevin Thompson", "Raul Torres"], "byRmTier":{}, "overall":{}},
  "perfRmDaily": {"labels":[], "rms":["Adam Moszczynski", "Cesar Perez", "Chris Messimer", "Kevin Thompson", "Raul Torres"], "data":{}}
};

let STATE = { snapshot: SEED, history: [] };

const SF_BASE = "https://airspace.lightning.force.com";
function sfLink(id){
  if(!id) return '–';
  return `<a href="${SF_BASE}/${id}" target="_blank" rel="noopener" style="color:var(--green);font-weight:600;text-decoration:none;">Open ↗</a>`;
}

function fmtDate(iso){
  if(!iso) return '';
  const parts = iso.split('-');
  return parts.length === 3 ? `${parts[1]}/${parts[2]}/${parts[0]}` : iso;
}

function fmtAsOfTZ(stamp){ return stamp || ''; }

function renderKpis(){
  const t = STATE.snapshot.totals;
  document.getElementById('asOfLabel').textContent = fmtAsOfTZ(STATE.snapshot.asOfStamp) || fmtDate(STATE.snapshot.asOf);
  const items = [
    {num:t.openFillIn, lbl:'Open fill-in cases', cls:''},
    {num:t.openPerformance, lbl:'Open performance cases', cls:''},
    {num:t.actionNeeded, lbl:'Action needed (fill-in)', cls:'warn'},
    {num:t.overdue, lbl:'Overdue (fill-in + performance)', cls:'crit'},
    {num:t.chronicDrivers, lbl:'Chronic last-minute drivers', cls:'crit'},
  ];
  document.getElementById('kpiRow').innerHTML = items.map(i=>`
    <div class="kpi ${i.cls}">
      <div class="num">${i.num}</div>
      <div class="lbl">${i.lbl}</div>
    </div>`).join('');
}

function rmHealth(rm){
  const fi = STATE.snapshot.fillinOpenByRm[rm] || {open:0,actionNeeded:0,overdue:0};
  const pf = STATE.snapshot.perfOpenByRm[rm] || {open:0,overdue:0};
  if(fi.overdue + pf.overdue > 0) return 'help';
  if(fi.open + pf.open > 0 && (fi.actionNeeded/(fi.open+pf.open)) > 0.3) return 'watch';
  return 'good';
}

function renderRmStrip(){
  const rms = STATE.snapshot.rms;
  document.getElementById('rmStrip').innerHTML = rms.map(rm=>{
    const fi = STATE.snapshot.fillinOpenByRm[rm] || {open:0,actionNeeded:0,overdue:0};
    const pf = STATE.snapshot.perfOpenByRm[rm] || {open:0,overdue:0};
    const health = rmHealth(rm);
    return `<div class="rm-card" data-health="${health}">
      <div class="rm-name">${rm}</div>
      <div class="rm-role">Regional Manager</div>
      <div class="rm-metric-row"><span>Open fill-ins</span><span class="v">${fi.open}</span></div>
      <div class="rm-metric-row"><span>Open performance</span><span class="v">${pf.open}</span></div>
      <div class="rm-metric-row"><span>Action needed</span><span class="v ${fi.actionNeeded>0?'amber':''}">${fi.actionNeeded}</span></div>
      <div class="rm-metric-row"><span>Overdue</span><span class="v ${fi.overdue+pf.overdue>0?'rust':''}">${fi.overdue+pf.overdue}</span></div>
    </div>`;
  }).join('');
}

function populateRmFilter(sel){
  const el = document.getElementById(sel);
  if(!el) return;
  STATE.snapshot.rms.forEach(rm=>{
    const o = document.createElement('option'); o.value=rm; o.textContent=rm; el.appendChild(o);
  });
}

function renderManualForm(){
  const rms = STATE.snapshot.rms;
  const head = `<div class="manual-row head"><div></div>${rms.map(r=>`<div>${r.split(' ')[0]}</div>`).join('')}</div>`;
  const fields = [{key:'open', label:'Open fill-ins'}, {key:'actionNeeded', label:'Action needed'}, {key:'overdue', label:'Overdue'}];
  const rows = fields.map(f=>`
    <div class="manual-row" data-field="${f.key}">
      <div>${f.label}</div>
      ${rms.map(r=>`<input type="number" min="0" data-rm="${r}" placeholder="0">`).join('')}
    </div>`).join('');
  document.getElementById('manualForm').innerHTML = head + rows;
}

function init(){
  populateRmFilter('fillinRmFilter');
  populateRmFilter('perfRmFilter');
  renderKpis();
  renderRmStrip();
  renderManualForm();
  
  document.getElementById('pageSwitcher').addEventListener('click', (e)=>{
    const btn = e.target.closest('.page-tab'); if(!btn) return;
    document.querySelectorAll('.page-tab').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('page-'+btn.dataset.page).classList.add('active');
  });
}

window.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
